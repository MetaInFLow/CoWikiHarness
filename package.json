{
  "name": "openlifewiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "openlifewiki": "pnpm --filter @openlifewiki/openlifewiki build && node packages/openlifewiki/dist/cli.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
