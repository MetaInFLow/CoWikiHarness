{
  "name": "openlifewiki",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "openlifewiki": "pnpm --filter @openlifewiki/cli build && node apps/cli/dist/main.js",
    "test": "pnpm -r test",
    "test:component:qmd": "OPENLIFEWIKI_REAL_COMPONENT_TEST=1 pnpm --filter @openlifewiki/adapters exec vitest run test/qmd-release.contract.test.ts",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
