# Optional development overrides. User data remains outside the repository.
# OPENLIFEWIKI_HOME=/path/to/openlifewiki-runtime
# OPENLIFEWIKI_WORKSPACE=/path/to/openLifeWiki

# 云端知识中枢。仅 cloud 命令与 apps/knowledge-server 使用。
# DATABASE_URL=postgres://openlifewiki:change-me@127.0.0.1:5432/openlifewiki
# Bearer token 的 HMAC 密钥，至少 32 字节；不要提交真实值。
# OPENLIFEWIKI_TOKEN_HMAC_SECRET=at-least-32-random-bytes
# Responses API 模型配置。
# OPENAI_API_KEY=replace-with-provider-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENLIFEWIKI_MODEL=gpt-5.5
# OPENLIFEWIKI_MODEL_REASONING_EFFORT=xhigh
# 响应存储在 V2 服务中必须关闭。
# OPENLIFEWIKI_DISABLE_RESPONSE_STORAGE=true
# Gateway 内部监听地址。默认只监听本机；只有受控容器网络才显式使用 0.0.0.0。
# OPENLIFEWIKI_BIND_HOST=127.0.0.1
# PORT=8080
# 对外可访问的 A2A JSON-RPC 地址；Agent Card 会发布该地址。
# OPENLIFEWIKI_PUBLIC_URL=https://knowledge.example.com
# 图谱 REST API 的精确浏览器 Origin 白名单；HTTPS 来源或回环地址 HTTP，逗号分隔。
# CORS 不提供身份认证，也不能防止 token 被提取后重放；不支持通配符。
# 生产可视化前端只访问自己的后端，member token 保存在后端 secret store。
# 当前 P0 没有独立用户登录/session，生产浏览器不直接持有 token 或调用 Graph REST。
# 非浏览器服务端调用不依赖 CORS。
# OPENLIFEWIKI_GRAPH_ALLOWED_ORIGINS=https://graph.example,http://127.0.0.1:5173
# 客户端服务地址；未设置时复用 OPENLIFEWIKI_PUBLIC_URL。
# COWIKIHARNESS_URL=http://127.0.0.1:8080
# 默认 Agent token，仅供 A2A ask/register/store/organize 命令使用。
# 本机受控调试的 cowiki graph 必须通过 --token-file 显式传入 user token 文件，不读取此默认值。
# COWIKIHARNESS_TOKEN_FILE=/absolute/path/to/agent.token
