<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.metainflow.cowikiharness.knowledge-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/scripts/run_knowledge_server.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__APP_SUPPORT__/logs/knowledge-server.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_SUPPORT__/logs/knowledge-server.error.log</string>
</dict>
</plist>
