{
  "name": "@openlifewiki/protocol",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate:schemas": "pnpm schema:generate",
    "schema:check": "pnpm build && node scripts/generate-agent-schemas.mjs --check",
    "schema:generate": "pnpm build && node scripts/generate-agent-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
